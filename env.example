# Root domain the platform runs on. Subdomains of this (acme.<this>) are
# tenants; the bare domain / "www" is the marketing/sales site. Leave unset
# to default to "boutiquedesk.app" (placeholder). Local dev works out of the
# box via *.localhost regardless of this value.
NEXT_PUBLIC_ROOT_DOMAIN=

# MongoDB connection string (e.g. MongoDB Atlas)
MONGODB_URI=

# Vercel Blob (image uploads for inventory)
BLOB_READ_WRITE_TOKEN=

# JWT secrets — use two long, random, distinct values.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Used to seed BoutiqueDesk's own platform_admin account (scripts/seed-super-admin.ts) —
# signs into /platform on the apex domain to manage signed-up boutiques.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Optional overrides for the one-time migration that creates the Organization
# for the original pre-SaaS business (scripts/migrate-add-tenant.ts).
# Defaults to "Color Times" / "color-times" if left unset.
EXISTING_ORG_NAME=
EXISTING_ORG_SLUG=
