# MongoDB connection string (e.g. MongoDB Atlas)
MONGODB_URI=

# Vercel Blob (image uploads for inventory)
BLOB_READ_WRITE_TOKEN=

# JWT secrets — use two long, random, distinct values.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Used to seed the first super-admin account (scripts/seed-super-admin.ts)
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
